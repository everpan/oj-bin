{
  "name": "oj-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "only-js (oj) 开发者手册站点",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "pnpm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/sync-docs.mjs",
    "dev": "vitepress dev .",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "sync": "node scripts/sync-docs.mjs",
    "check": "node scripts/check-links.mjs",
    "verify": "pnpm run sync && pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
